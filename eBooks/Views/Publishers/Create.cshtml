@using eBooks.ViewModels.Publishers
@model CreatePublisherViewModel

@{
    ViewData["Title"] = "Create Publishers";
}

<div class="row text">
    <div class="col-md-8 offset-2">
        <p>
            <h1> Create publisher</h1>

        </p>
        <div class="row">
            <div class="col-md-8 offset-2">
                <form asp-action="Create" method="post">
                    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                
                <div class="form-group">
                    <label asp-for="ProfileURLPicture" class="control-label"></label>
                    <input asp-for="ProfileURLPicture" class="form-control" />
                    <span asp-validation-for="ProfileURLPicture" class="text-danger"></span>
                </div>
                <div class="form-group">
                    <label asp-for="Name" class="control-label"></label>
                    <input asp-for="Name" class="form-control" />
                    <span asp-validation-for="Name" class="text-danger"></span>
                </div>
                
                <div class="form-group"></div>
                <input type="submit" value="Create" class="btn btn-outline-success float-right" />
                <a class="btn btn-outline-secondary" asp-action="Index">Show all</a>
                </form>
            </div>
        </div>
    </div>
</div>