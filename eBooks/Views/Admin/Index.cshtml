@{
    ViewData["Title"] = "Manage site";
}

<div class="container py-4">
    <h1>🛠 Manage site</h1>

    <p>
        eBooks.exe Administration Center
        Select the section you wish to manage.
    </p>

    <div class="row g-3 mt-3">
        <div class="col-12 col-md-6 col-lg-3">
            <a asp-controller="Books"
               asp-action="Index"
               class="btn btn-primary w-100">
                📚 Books
            </a>
        </div>

        <div class="col-12 col-md-6 col-lg-3">
            <a asp-controller="Authors"
               asp-action="Index"
               class="btn btn-primary w-100">
                ✍️ Authors
            </a>
        </div>

        <div class="col-12 col-md-6 col-lg-3">
            <a asp-controller="Categories"
               asp-action="Index"
               class="btn btn-primary w-100">
                💿 Categories
            </a>
        </div>

        <div class="col-12 col-md-6 col-lg-3">
            <a asp-controller="Publishers"
               asp-action="Index"
               class="btn btn-primary w-100">
                🏢 Publishers
            </a>
        </div>

        <div class="col-12 col-md-6 col-lg-3">
            <a asp-controller="AdminOrders"
               asp-action="Index"
               class="btn btn-primary w-100">
                📦 Manage orders
            </a>
        </div>

        <div class="col-12 col-md-6 col-lg-3">
            <a asp-controller="ReviewModeration"
               asp-action="Index"
               class="btn btn-primary w-100">
                ⭐ Moderate reviews
            </a>
        </div>

    </div>

    <div class="mt-4">
        <a asp-controller="Catalog"
           asp-action="Index"
           class="btn btn-outline-secondary">
            Return to the public catalog
        </a>
    </div>

    
</div>