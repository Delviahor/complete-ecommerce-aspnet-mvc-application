@using eBooks.Data.Enums
@using eBooks.ViewModels.Books
@model CreateBookViewModel

<h2>Create Book</h2>

<form asp-action="Create" method="post">

    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

    <div>
        <label asp-for="Title"></label>
        <input asp-for="Title" class="form-control" />
        <span asp-validation-for="Title" class="text-danger"></span>
    </div>

    <div>
        <label asp-for="Description"></label>
        <textarea asp-for="Description" class="form-control"></textarea>
        <span asp-validation-for="Description" class="text-danger"></span>
    </div>

    <div>
        <label asp-for="Price"></label>
        <input asp-for="Price" class="form-control" />
        <span asp-validation-for="Price" class="text-danger"></span>
    </div>

    <div>
        <label asp-for="Pages"></label>
        <input asp-for="Pages" class="form-control" />
        <span asp-validation-for="Pages" class="text-danger"></span>
    </div>

    <div>
        <label asp-for="PublicationDate"></label>
        <input asp-for="PublicationDate" class="form-control" />
        <span asp-validation-for="PublicationDate" class="text-danger"></span>
    </div>

    <div>
        <label asp-for="CoverURLPicture"></label>
        <input asp-for="CoverURLPicture" class="form-control" />
        <span asp-validation-for="CoverURLPicture" class="text-danger"></span>
    </div>

    <div>
        <label asp-for="InStock"></label>
        <input asp-for="InStock" class="form-control" />
        <span asp-validation-for="InStock" class="text-danger"></span>
    </div>

    <div>
        <label asp-for="Language"></label>
        <select asp-for="Language"
                asp-items="Html.GetEnumSelectList<Book_Language>()"
                class="form-select">
        </select>
    </div>

    <div>
        <label asp-for="Format"></label>
        <select asp-for="Format"
                asp-items="Html.GetEnumSelectList<Book_Format>()"
                class="form-select">
        </select>
    </div>

    <div>
        <label asp-for="CategoryId"></label>
        <select asp-for="CategoryId"
                asp-items="Model.Categories"
                class="form-select">
            <option value="">Seleccione una categoría</option>
        </select>
    </div>

    <div>
        <label asp-for="PublisherId"></label>
        <select asp-for="PublisherId"
                asp-items="Model.Publishers"
                class="form-select">
            <option value="">Seleccione una editorial</option>
        </select>
    </div>

    <div>
        <label asp-for="AuthorIds"></label>
        <select asp-for="AuthorIds"
                asp-items="Model.Authors"
                class="form-select"
                multiple>
        </select>
    </div>

    <br />

    <button type="submit" class="btn btn-success">
        Save
    </button>

</form>