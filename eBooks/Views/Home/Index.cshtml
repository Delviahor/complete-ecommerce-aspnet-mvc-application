@{
    ViewData["Title"] = "Home";
}

<section class="container py-5">
    <div class="text-center">
        <p class="text-uppercase fw-bold">
            ★ WELCOME TO YOUR DIGITAL BOOK UNIVERSE ★
        </p>

        <h1 class="display-3 fw-bold">
            Welcome to <span>eBooks.exe</span>
        </h1>

        <p class="lead mt-3">
            Your next adventure is just one click away.
        </p>

        <p class="mx-auto" style="max-width: 650px;">
            Explore science fiction, fantasy, mystery, horror and more.
            Discover authors, find your next favorite story and expand
            your digital universe.
        </p>

        <div class="d-flex flex-wrap justify-content-center gap-3 mt-4">
            <a asp-controller="Catalog"
               asp-action="Index"
               class="retro-button text-decoration-none">
                📚 EXPLORE CATALOG
            </a>

            @if (User.IsInRole("Admin"))
            {
                <a asp-controller="Admin"
                   asp-action="Index"
                   class="retro-button text-decoration-none">
                    🛠 ADMINISTRAR SITIO
                </a>
            }
        </div>
    </div>

    <hr class="my-5" />

    <div class="row g-4 text-center">
        <div class="col-12 col-md-4">
            <div class="p-3 h-100">
                <h2 class="h4">📖 Discover</h2>
                <p>
                    Explore our collection and discover books
                    from different genres.
                </p>
            </div>
        </div>

        <div class="col-12 col-md-4">
            <div class="p-3 h-100">
                <h2 class="h4">✍️ Explore authors</h2>
                <p>
                    Find the writers behind the stories
                    you love.
                </p>
            </div>
        </div>

        <div class="col-12 col-md-4">
            <div class="p-3 h-100">
                <h2 class="h4">🌌 Begin an adventure</h2>
                <p>
                    Every book opens a door to a new world
                    of ideas and imagination.
                </p>
            </div>
        </div>
    </div>
</section>
