@model List<Book>

@{
    ViewData["Title"] = "Books";
}

<table border="1" cellpadding="8" cellspacing="0" style="width:100%; border-collapse: collapse;">
    <thead>
        <tr>
            <th>Title</th>
            <th>Description</th>
            <th>Pages</th>
            <th>Price</th>
            <th>In Stock</th>
            <th>Status</th>
            <th>Language</th>
            <th>Format</th>
            <th>Publisher</th>
        </tr>


    </thead>

    <tbody>
        @foreach (var book in Model)
        {
            <tr>
                <td>@book.Title</td>
                <td>@book.Description</td>
                <td>@book.Pages</td>
                <td>@book.Price</td>
                <td>@book.InStock</td>
                <td>@book.Status</td>
                <td>@book.Language</td>
                <td>@book.Format</td>

                <td>@book.Category.Name</td>
                <td>@book.Publisher.Name</td>

                <td>
                    @string.Join(", ", book.AuthorBooks.Select(ab => ab.Author.FullName))
                </td>

                <td>
                    <a asp-action="Edit"
                       asp-route-id="@book.BookId"
                       class="btn btn-warning">
                        Edit
                    </a>
                </td>
            </tr>
        }
    </tbody>
</table>