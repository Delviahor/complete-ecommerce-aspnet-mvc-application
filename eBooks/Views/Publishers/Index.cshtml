@model List<Publisher>

@{
    ViewData["Title"] = "Publishers";
}

<div class="publishers-page">
    <h2 class="retro-heading">🏢 Publishers.exe</h2>

    <div class="table-container">
        <table class="books-table publishers-table">
            <thead>
                <tr>
                    <th>#</th>
                    <th>Photo</th>
                    <th>Publisher Name</th>
                    <th>Actions</th>
                </tr>
            </thead>

            <tbody>
                @foreach (var publisher in Model)
                {
                    <tr>
                        <td class="publisher-id">
                            @publisher.PublisherId
                        </td>

                        <td class="publisher-photo">
                            @if (!string.IsNullOrWhiteSpace(publisher.ProfileURLPicture))
                            {
                                <img src="@publisher.ProfileURLPicture"
                                     alt="Photo of @publisher.Name"
                                     class="publisher-thumbnail" />
                            }
                            else
                            {
                                <span class="no-photo">No photo</span>
                            }
                        </td>

                        <td class="publisher-name">
                            @publisher.Name
                        </td>

                        <td class="book-actions">
                            <a asp-action="Edit"
                               asp-route-id="@publisher.PublisherId"
                               class="btn btn-warning">
                                Edit
                            </a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <p class="authors-count">
        Total publishers: <strong>@Model.Count</strong>
    </p>
</div>
