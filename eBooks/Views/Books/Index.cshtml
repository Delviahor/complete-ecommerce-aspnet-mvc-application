@model List<Book>

@{
    ViewData["Title"] = "Books";
}

<div class="books-page">
    <h2 class="retro-heading">📚 Books.exe</h2>

    <div class="table-container">
        <table class="books-table books-catalog-table">
            <thead>
                <tr>
                    <th>Book</th>
                    <th>Description</th>
                    <th>Publication</th>
                    <th>Category</th>
                    <th>Publisher</th>
                    <th>Authors</th>
                    <th>Inventory</th>
                    <th>Actions</th>
                </tr>
            </thead>

            <tbody>
                @foreach (var book in Model)
                {
                    <tr>
                        <td class="catalog-book">
                            @if (!string.IsNullOrWhiteSpace(book.CoverURLPicture))
                            {
                                <img src="@book.CoverURLPicture"
                                     alt="Cover of @book.Title"
                                     class="book-cover-thumbnail" />
                            }
                            else
                            {
                                <div class="book-cover-placeholder">
                                    NO COVER
                                </div>
                            }

                            <div class="catalog-book-title">
                                @book.Title
                            </div>
                        </td>

                        <td class="catalog-description">
                            @if (!string.IsNullOrWhiteSpace(book.Description))
                            {
                                @book.Description
                            }
                            else
                            {
                                <span class="no-photo">No description</span>
                            }
                        </td>

                        <td class="catalog-publication">
                            <div><strong>Pages:</strong> @book.Pages</div>
                            <div><strong>Date:</strong> @book.PublicationDate</div>
                            <div><strong>Language:</strong> @book.Language</div>
                            <div><strong>Format:</strong> @book.Format</div>
                        </td>

                        <td>@book.Category.Name</td>

                        <td>@book.Publisher.Name</td>

                        <td class="catalog-authors">
                            @string.Join(", ",
                            book.AuthorBooks.Select(ab => ab.Author.FullName))
                    </td>

                    <td class="catalog-inventory">
                        <div><strong>Price:</strong> @book.Price.ToString("C")</div>
                        <div><strong>Stock:</strong> @book.InStock</div>
                        <div><strong>Status:</strong> @book.Status</div>
                    </td>

                    <td class="book-actions">
                        <a asp-action="Edit"
                           asp-route-id="@book.BookId"
                           class="btn btn-warning">
                            Edit
                        </a>
                    </td>
                </tr>
                                }
            </tbody>
        </table>
    </div>

    <p class="authors-count">
        Total Books: <strong>@Model.Count</strong>
    </p>
</div>
