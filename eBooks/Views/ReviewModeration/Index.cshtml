@model List<eBooks.Models.BookReview>

@{
    ViewData["Title"] = "Review moderation";
}

<div class="container py-4">
    <nav aria-label="Navigation">
        <a asp-controller="Admin"
           asp-action="Index"
           class="text-decoration-none">
            &larr; Return to Manage
        </a>
    </nav>

    <h1 class="mt-3">Review moderation</h1>

    <p class="text-muted">
        Review the comments submitted by readers before publishing them.
    </p>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success" role="alert">
            @TempData["Success"]
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger" role="alert">
            @TempData["Error"]
        </div>
    }

    <hr class="my-4" />

    @if (Model.Any())
    {
        <p>
            Pending reviews:
            <strong>@Model.Count</strong>
        </p>

        <div class="row g-3">
            @foreach (var review in Model)
            {
                <div class="col-12">
                    <article class="card">
                        <div class="card-body">

                            <div class="d-flex justify-content-between flex-wrap gap-2">
                                <h2 class="h5 mb-0">
                                    @review.Book?.Title
                                </h2>

                                <span class="text-warning">
                                    @for (int i = 1; i <= 5; i++)
                                    {
                                        @(i <= review.Rating ? "★" : "☆")
                                    }
                                </span>
                            </div>

                            <p class="text-muted small mt-2 mb-2">
                                Usuario:
                                @(review.User?.UserName ?? "Unknown user")
                            </p>

                            <p class="mb-2 text-break">
                                @review.Content
                            </p>

                            <div class="d-flex flex-wrap gap-2 align-items-center">
                                <span class="text-muted small">
                                    Sent:
                                    @review.CreatedAtUtc.ToString("dd/MM/yyyy HH:mm")
                                </span>

                                @if (review.IsVerifiedPurchase)
                                {
                                    <span class="badge bg-success">
                                        Verified purchase
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">
                                        No verified purchase
                                    </span>
                                }
                            </div>

                            <hr />

                            <div class="d-flex flex-wrap gap-2">
                                <form asp-controller="ReviewModeration"
                                      asp-action="UpdateStatus"
                                      method="post">

                                    @Html.AntiForgeryToken()

                                    <input type="hidden"
                                           name="reviewId"
                                           value="@review.BookReviewId" />

                                    <input type="hidden"
                                           name="status"
                                           value="@eBooks.Data.Enums.Review_Status.Published" />

                                    <button type="submit"
                                            class="btn btn-success btn-sm">
                                        Approve
                                    </button>
                                </form>

                                <form asp-controller="ReviewModeration"
                                      asp-action="UpdateStatus"
                                      method="post">

                                    @Html.AntiForgeryToken()

                                    <input type="hidden"
                                           name="reviewId"
                                           value="@review.BookReviewId" />

                                    <input type="hidden"
                                           name="status"
                                           value="@eBooks.Data.Enums.Review_Status.Rejected" />

                                    <button type="submit"
                                            class="btn btn-danger btn-sm">
                                        Decline
                                    </button>
                                </form>
                            </div>

                        </div>
                    </article>
                </div>
            }
        </div>
    }
    else
    {
        <div class="alert alert-info">
            There are no reviews awaiting moderation.
        </div>
    }
</div>
