@model eBooks.Models.Order

@using eBooks.Data.Enums
@using System.Globalization

@{
    ViewData["Title"] = "Order Details";

    var culture = new CultureInfo("es-MX");

    decimal orderTotal = Model.Items.Sum(
        item => item.UnitPrice * item.Quantity
    );
}

<div class="container my-5">

    <div class="d-flex justify-content-between align-items-center flex-wrap gap-3 mb-4">

        <div>
            <h1>ORDER DETAILS</h1>
            <h5 class="text-muted">Order #@Model.OrderId</h5>
        </div>

        <a asp-controller="Orders"
           asp-action="Index"
           class="btn btn-outline-secondary">
            BACK TO MY ORDERS
        </a>

    </div>

    <!-- Order information -->

    <div class="card mb-4">

        <div class="card-header">
            <h5 class="mb-0">ORDER INFORMATION</h5>
        </div>

        <div class="card-body">

            <div class="row">

                <div class="col-md-6 mb-3">
                    <strong>Order number:</strong>
                    <p>#@Model.OrderId</p>
                </div>

                <div class="col-md-6 mb-3">
                    <strong>Order date:</strong>
                    <p>
                        @(Model.CreatedAtUtc.ToLocalTime().ToString("dd/MM/yyyy HH:mm"))
                    </p>
                </div>

                <div class="col-md-6 mb-3">
                    <strong>Status:</strong>

                    <p>
                        @switch (Model.Status)
                        {
                            case Order_Status.Pending:
                                <span class="badge bg-warning text-dark">
                                    Pending
                                </span>
                                break;

                            case Order_Status.Accepted:
                                <span class="badge bg-info text-dark">
                                    Accepted
                                </span>
                                break;

                            case Order_Status.Preparing:
                                <span class="badge bg-primary">
                                    Preparing
                                </span>
                                break;

                            case Order_Status.Shipped:
                                <span class="badge bg-secondary">
                                    Shipped
                                </span>
                                break;

                            case Order_Status.Delivered:
                                <span class="badge bg-success">
                                    Delivered
                                </span>
                                break;

                            case Order_Status.Cancelled:
                                <span class="badge bg-danger">
                                    Cancelled
                                </span>
                                break;
                        }
                    </p>
                </div>

                <div class="col-md-6 mb-3">
                    <strong>Total:</strong>
                    <p class="fw-bold">
                        @orderTotal.ToString("C", culture)
                    </p>
                </div>

            </div>

        </div>

    </div>

    <!-- Shipping address -->

    <div class="card mb-4">

        <div class="card-header">
            <h5 class="mb-0">SHIPPING ADDRESS</h5>
        </div>

        <div class="card-body">

            <p>
                <strong>Recipient:</strong>
                @Model.RecipientName
            </p>

            <p>
                <strong>Phone:</strong>
                @Model.Phone
            </p>

            <p>
                <strong>Street:</strong>
                @Model.Street, @Model.Number
            </p>

            <p>
                <strong>Neighborhood:</strong>
                @Model.Neighborhood
            </p>

            <p>
                <strong>City:</strong>
                @Model.City, @Model.State
            </p>

            <p>
                <strong>Postal code:</strong>
                @Model.PostalCode
            </p>

            @if (!string.IsNullOrWhiteSpace(Model.References))
            {
                <p>
                    <strong>References:</strong>
                    @Model.References
                </p>
            }

        </div>

    </div>

    <!-- Purchased items -->

    <div class="card mb-4">

        <div class="card-header">
            <h5 class="mb-0">PURCHASED BOOKS</h5>
        </div>

        <div class="card-body">

            <div class="table-responsive">

                <table class="table table-bordered align-middle">

                    <thead>
                        <tr>
                            <th>Book</th>
                            <th>Unit price</th>
                            <th>Quantity</th>
                            <th>Subtotal</th>
                        </tr>
                    </thead>

                    <tbody>

                        @foreach (var item in Model.Items)
                        {
                            decimal subtotal = item.UnitPrice * item.Quantity;

                            <tr>

                                <td>
                                    <div class="d-flex align-items-center gap-3">

                                        @if (!string.IsNullOrWhiteSpace(item.CoverURLPicture))
                                        {
                                            <img src="@item.CoverURLPicture"
                                                 alt="@item.BookTitle"
                                                 style="width: 65px; height: 90px; object-fit: cover;" />
                                        }

                                        <strong>@item.BookTitle</strong>

                                    </div>
                                </td>

                                <td>
                                    @item.UnitPrice.ToString("C", culture)
                                </td>

                                <td>
                                    @item.Quantity
                                </td>

                                <td>
                                    @subtotal.ToString("C", culture)
                                </td>

                            </tr>
                        }

                    </tbody>

                    <tfoot>
                        <tr>
                            <th colspan="3" class="text-end">
                                ORDER TOTAL
                            </th>

                            <th>
                                @orderTotal.ToString("C", culture)
                            </th>
                        </tr>
                    </tfoot>

                </table>

            </div>

        </div>

    </div>

    <!-- Cancellation -->
    @if (Model.Status == Order_Status.Pending)
    {
        <div class="d-flex justify-content-end">

            <form asp-controller="Orders"
                  asp-action="Cancel"
                  asp-route-id="@Model.OrderId"
                  method="post"
                  onsubmit="return confirm('Are you sure you want to cancel this order?');">

                @Html.AntiForgeryToken()

                <button type="submit"
                        class="btn btn-outline-danger">
                    CANCEL ORDER
                </button>

            </form>

        </div>
    }

</div>
