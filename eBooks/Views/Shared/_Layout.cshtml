<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - eBooks.exe</title>

    <link rel="stylesheet"
          href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet"
          href="~/css/site.css"
          asp-append-version="true" />
    <link rel="stylesheet"
          href="~/eBooks.styles.css"
          asp-append-version="true" />
</head>

<body>
    <div class="retro-shell">

        <header class="site-header">
            <div class="top-strip">
                <span>★ WELCOME TO THE INTERNET ★</span>
                <span class="online-indicator">
                    <span class="online-dot"></span> SYSTEM ONLINE
                </span>
            </div>

            

            <a class="brand-logo"
               asp-controller="Home"
               asp-action="Index">
                <span class="brand-symbol">📚</span>
                <span>eBooks<span class="brand-exe">.exe</span></span>
                <span class="brand-sparkle">✦</span>
            </a>

            <div class="brand-subtitle">
                YOUR DIGITAL BOOK UNIVERSE
            </div>

            <div class="marquee-bar">
                <span>★ ENTER THE WORLD OF BOOKS ★</span>
                <span>✦ AUTHORS • STORIES • KNOWLEDGE ✦</span>
                <span>★ BEST VIEWED WITH A LOVE FOR READING ★</span>
            </div>

            <div class="account-navigation">
                @if (User.Identity != null && User.Identity.IsAuthenticated)
                {
                    <a asp-controller="UserProfiles"
                       asp-action="Details"
                       asp-route-id="@User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value">
                        👤 MY PROFILE
                    </a>

                    <a asp-controller="Cart"
                       asp-action="Index">
                        🛒 MY CART
                    </a>

                    <a asp-controller="Orders"
                       asp-action="Index">
                        📦 MY ORDERS
                    </a>

                    <form asp-area="Identity"
                          asp-page="/Account/Logout"
                          asp-route-returnUrl="/"
                          method="post">

                        <button type="submit">
                            🚪 LOGOUT
                        </button>

                    </form>
                }
                else
                {
                    <a asp-area="Identity"
                       asp-page="/Account/Login">
                        🔑 LOGIN
                    </a>

                    <a asp-area="Identity"
                       asp-page="/Account/Register">
                        ✍ REGISTER
                    </a>
                }
            </div>

        </header>

        <nav class="retro-nav navbar navbar-expand-lg">
            <div class="container-fluid">
                <button class="navbar-toggler retro-toggler"
                        type="button"
                        data-bs-toggle="collapse"
                        data-bs-target="#retroNavbar"
                        aria-controls="retroNavbar"
                        aria-expanded="false"
                        aria-label="Open navigation">
                    ☰ MENU
                </button>

                <div class="collapse navbar-collapse" id="retroNavbar">
                    <ul class="navbar-nav retro-nav-links">
                        <li class="nav-item">
                            <a class="nav-link"
                               asp-controller="Home"
                               asp-action="Index">
                                🏠 HOME
                            </a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link"
                               asp-controller="Catalog"
                               asp-action="Index">
                                📚 CATALOG
                            </a>
                        </li>

                        
                    </ul>



                    <div class="ms-lg-auto mt-3 mt-lg-0">
                        @if (User.IsInRole("Admin"))
                        {
                            <a class="retro-button text-decoration-none"
                               asp-controller="Admin"
                               asp-action="Index">
                                🛠 MANAGE SITE
                            </a>
                        }
                    </div>

                    <form class="retro-search"
                          asp-controller="Books"
                          asp-action="Filter"
                          method="get">

                        <input name="searchString"
                               type="search"
                               class="form-control"
                               placeholder="Search the database..."
                               aria-label="Search books" />

                        <button type="submit"
                                class="retro-button">
                            GO!
                        </button>
                    </form>
                </div>
            </div>
        </nav>

        <div class="under-construction">
            <span>🚧</span>
            <span>WELCOME, INTERNET EXPLORER!</span>
            <span>★</span>
            <span>YOU ARE VISITOR #0001999</span>
            <span>🚧</span>
        </div>

        <main role="main" class="retro-main">
            @RenderBody()
        </main>

        <footer class="retro-footer">
            <div class="footer-divider">
                ✦ ━━━━━━━━━━━━━━━━━━━━━━━━━━━ ✦
            </div>

            <div class="footer-title">
                📀 eBooks.exe © 2026
            </div>

            <p>MADE WITH CODE, CAFFEINE &amp; PIXELS.</p>

            <a asp-controller="Home" asp-action="Privacy">
                PRIVACY POLICY
            </a>

            <p class="footer-small">
                THIS SITE RUNS ON PURE INTERNET MAGIC ✨
            </p>
        </footer>

    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
