@{
    ViewData["Title"] = "Administrar sitio";
}

<div class="container py-4">
    <h1>🛠 Administrar sitio</h1>

    <p>
        Centro de administración de eBooks.exe.
        Selecciona la sección que deseas gestionar.
    </p>

    <div class="row g-3 mt-3">
        <div class="col-12 col-md-6 col-lg-3">
            <a asp-controller="Books"
               asp-action="Index"
               class="btn btn-primary w-100">
                📚 Libros
            </a>
        </div>

        <div class="col-12 col-md-6 col-lg-3">
            <a asp-controller="Authors"
               asp-action="Index"
               class="btn btn-primary w-100">
                ✍️ Autores
            </a>
        </div>

        <div class="col-12 col-md-6 col-lg-3">
            <a asp-controller="Categories"
               asp-action="Index"
               class="btn btn-primary w-100">
                💿 Categorías
            </a>
        </div>

        <div class="col-12 col-md-6 col-lg-3">
            <a asp-controller="Publishers"
               asp-action="Index"
               class="btn btn-primary w-100">
                🏢 Editoriales
            </a>
        </div>

        <div class="col-12 col-md-6 col-lg-3">
            <a asp-controller="AdminOrders"
               asp-action="Index"
               class="btn btn-primary w-100">
                📦 Gestionar pedidos
            </a>
        </div>
    </div>

    <div class="mt-4">
        <a asp-controller="Catalog"
           asp-action="Index"
           class="btn btn-outline-secondary">
            Volver al catálogo público
        </a>
    </div>

    
</div>