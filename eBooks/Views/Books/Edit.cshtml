@using eBooks.Data.Enums
@using eBooks.ViewModels.Books
@model EditBookViewModel

<form asp-action="Edit" class="edit-form">

    <input asp-for="BookId" type="hidden" />

    <div class ="mb-3">
        <label asp-for="Title"></label>
        <input asp-for="Title" />
    </div>

    <div class="mb-3">
        <label asp-for="Description"></label>
        <textarea asp-for="Description"></textarea>
    </div>

    <div class="mb-3">
        <label asp-for="Price"></label>
        <input asp-for="Price" />
    </div>

    <div class="mb-3">
        <label asp-for="Pages"></label>
        <input asp-for="Pages" />
    </div>

    <div class="mb-3">
        <label asp-for="InStock"></label>
        <input asp-for="InStock" />
    </div>

    <div class="mb-3">
        <label asp-for="Format">Format</label>
        <select asp-for="Format"
                asp-items="Html.GetEnumSelectList<Book_Format>()">
        </select>
    </div>

    <div class="mb-3">
        <label asp-for="CategoryId">Categoría</label>
        <select asp-for="CategoryId"
                asp-items="Model.Categories">
        </select>
    </div>

    <div class="mb-3">
        <label asp-for="PublisherId">Editorial</label>
        <select asp-for="PublisherId"
                asp-items="Model.Publishers">
        </select>
    </div>

    <div class="mb-3">
        <label asp-for="AuthorIds">Authors</label>
        <select asp-for="AuthorIds"
                asp-items="Model.Authors"
                multiple>
        </select>
    </div>

    <div class="mb-3">
        <label asp-for="Language">Language</label>
        <select asp-for="Language"
                asp-items="Html.GetEnumSelectList<Book_Language>()">
        </select>
    </div>

    <div class="mb-3">
        <label asp-for="Status">Status</label>
        <select asp-for="Status"
                asp-items="Html.GetEnumSelectList<Book_Status>()">
        </select>
    </div>



    <button type="submit">
        Save changes
    </button>

</form>