@model eBooks.Models.Book

@{
    ViewData["Title"] = Model.Title;
}

<div class="container py-4">
    <nav aria-label="Navegación">
        <a asp-controller="Catalog" asp-action="Index"
           class="text-decoration-none">
            &larr; Volver al catálogo
        </a>
    </nav>

    <div class="row g-4 g-lg-5 mt-2">
        <div class="col-12 col-md-5 col-lg-4">
            @if (!string.IsNullOrWhiteSpace(Model.CoverURLPicture))
            {
                <img src="@Model.CoverURLPicture"
                     alt="Portada de @Model.Title"
                     class="img-fluid rounded shadow-sm w-100"
                     style="max-height: 560px; object-fit: contain;" />
            }
            else
            {
                <div class="bg-light rounded d-flex align-items-center justify-content-center"
                     style="min-height: 350px;">
                    <span class="text-muted">Sin portada disponible</span>
                </div>
            }
        </div>



        <div class="col-12 col-md-7 col-lg-8">
            <p class="text-muted mb-2">
                @Model.Category?.Name
            </p>

            <h1 class="display-5">@Model.Title</h1>

            <p class="fs-5">
                @if (Model.AuthorBooks.Any())
                {
                    @string.Join(", ", Model.AuthorBooks.Select(ab => ab.Author.FullName))
                }
                else
                {
                    <span>Autor no especificado</span>
                }
            </p>

            <p class="text-muted">
                Editorial: @(Model.Publisher?.Name ?? "No especificada")
            </p>

            <p class="display-6 fw-bold my-4">
                @Model.Price.ToString("C")
            </p>



            @if (Model.Status == eBooks.Data.Enums.Book_Status.OutOfStock
                        || Model.InStock <= 0)
            {
                <div class="alert alert-danger" role="status">
                    Este libro está agotado actualmente.
                </div>
            }
            else
            {
                <div class="alert alert-success" role="status">
                    Available now.
                </div>
            }


            @if (Model.Status == eBooks.Data.Enums.Book_Status.Published
                        && Model.InStock > 0)
            {
                <form asp-controller="Cart"
                      asp-action="Add"
                      method="post"
                      class="mt-3">

                    @Html.AntiForgeryToken()

                    <input type="hidden"
                           name="bookId"
                           value="@Model.BookId" />

                    <div class="mb-3">
                        <label for="quantity" class="form-label">
                            Cantidad
                        </label>

                        <input type="number"
                               id="quantity"
                               name="quantity"
                               value="1"
                               min="1"
                               max="10"
                               class="form-control"
                               style="width: 100px;"
                               required />
                    </div>

                    <button type="submit" class="btn btn-primary">
                        ADD TO CART
                    </button>
                </form>
            }


            @if (!string.IsNullOrWhiteSpace(Model.Description))
            {
                <section class="mt-4">
                    <h2 class="h4">Descripción</h2>
                    <p class="text-break">@Model.Description</p>
                </section>
            }

            <hr class="my-4" />

            <dl class="row">
                <dt class="col-sm-4">Páginas</dt>
                <dd class="col-sm-8">@Model.Pages</dd>

                <dt class="col-sm-4">Idioma</dt>
                <dd class="col-sm-8">@Model.Language</dd>

                <dt class="col-sm-4">Formato</dt>
                <dd class="col-sm-8">@Model.Format</dd>

                <dt class="col-sm-4">Publicación</dt>
                <dd class="col-sm-8">@Model.PublicationDate.ToString("dd/MM/yyyy")</dd>
            </dl>



            <a asp-controller="Catalog"
               asp-action="Index"
               class="btn btn-outline-secondary mt-3">
                Seguir explorando
            </a>
        </div>
    </div>
</div>
