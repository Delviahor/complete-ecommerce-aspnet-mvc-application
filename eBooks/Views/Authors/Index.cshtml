@model List<Author>

@{
    ViewData["Title"] = "Authors";
}

<div class="authors-page">
    <h2 class="retro-heading">📚 Authors.exe</h2>

    <div class="table-container">
        <table class="books-table authors-table">
            <thead>
                <tr>
                    <th>#</th>
                    <th>Photo</th>
                    <th>Full Name</th>
                    <th>Biography</th>
                    <th>Actions</th>
                </tr>
            </thead>

            <tbody>
                @{
                    int i = 1;
                }

                @foreach (var author in Model)
                {
                    <tr>
                        <td>@i</td>

                        <td class="author-photo">
                            @if (!string.IsNullOrWhiteSpace(author.ProfileURLPicture))
                            {
                                <img src="@author.ProfileURLPicture"
                                     alt="Photo of @author.FullName"
                                     class="author-thumbnail" />
                            }
                            else
                            {
                                <span class="no-photo">No photo</span>
                            }
                        </td>

                        <td class="author-name">
                            @author.FullName
                        </td>

                        <td class="author-biography">
                            @if (!string.IsNullOrWhiteSpace(author.Biography))
                            {
                                @author.Biography
                            }
                            else
                            {
                                <span class="no-photo">No biography</span>
                            }
                        </td>

                        <td class="book-actions">
                            <a asp-action="Edit"
                               asp-route-id="@author.AuthorId"
                               class="btn btn-warning">
                                Edit
                            </a>
                        </td>
                    </tr>

                    i++;
                }
            </tbody>
        </table>
    </div>

    <p class="authors-count">
        Total Authors: <strong>@Model.Count</strong>
    </p>
</div>
